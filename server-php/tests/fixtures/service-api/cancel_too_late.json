{
    "scenario": "cancel_too_late",
    "request": {
        "POST": "v1/messages/{message_uuid}/cancel",
        "body": {
            "cmp_id": 9301
        }
    },
    "response": {
        "status": 409,
        "body": {
            "error": {
                "code": "already_dispatched",
                "message": "The provider already holds this message (or it is already finished), so it cannot be withdrawn.",
                "details": {
                    "retryable": false,
                    "delivery_state": "sent"
                }
            },
            "data": {
                "message_uuid": "{{message_uuid}}",
                "message_id": "{{message_id}}",
                "conversation_uuid": "{{conversation_uuid}}",
                "status": "provider_accepted",
                "status_label": "Accepted by provider, delivery not confirmed",
                "delivery_state": "sent",
                "reason_code": null,
                "reason": null,
                "delivered": false,
                "terminal": false,
                "channel": "whatsapp",
                "kind": "reminder",
                "reference": "7d4f0b1e-52c3-4a8e-9f10-2b6a8c3d9e01",
                "reference_label": "AP-1042",
                "scheduled_for": "{{timestamp}}",
                "not_after": "{{timestamp}}",
                "queued_at": "{{timestamp}}",
                "provider_accepted_at": "{{timestamp}}",
                "delivered_at": null,
                "failed_at": null,
                "provider_message_id": "{{provider_message_id}}",
                "failure_code": null,
                "failure_detail": null,
                "cancelled": false
            },
            "message": "The message could not be withdrawn."
        }
    }
}
