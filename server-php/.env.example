# ---------------------------------------------------------------------------
# Messaging API — server environment template
#
# Unlike the React build, this file is read at RUNTIME on every request. It
# belongs on the server and only on the server:
#
#   1. Copy this file to <document root>/api/.env by hand, once (cPanel File
#      Manager or SSH).
#   2. It is git-ignored, and every rsync step passes --exclude='.env', so a
#      --delete deploy leaves it untouched.
#
# EVERY VALUE BELOW IS A PLACEHOLDER. Nothing in this file is a real
# credential, and nothing real may ever be committed to it. Fill it in on the
# server.
#
# See docs/DEPLOYMENT.md, docs/ARCHITECTURE.md and docs/SECURITY.md.
# ---------------------------------------------------------------------------

# Which deployment this is: production | sandbox | local
# Reported by GET /api/health, so you can tell the two environments apart.
APP_ENV=production

# This product's own key, used as the X-Saas-Origin it sends to sibling
# products. Leave it as it is.
APP_PRODUCT_KEY=messaging

# AICOUNTLY portal auth API. Leave unset unless you are pointing at a
# non-standard portal — my.aicountly.com serves BOTH production and sandbox.
# (sandbox.aicountly.com is a login redirect only; it does not serve seskey or
# validatesession.)
# PORTAL_AUTH_BASE=https://my.aicountly.com

# Comma-separated origins allowed to call this API cross-origin.
# Both deployed environments are same-origin with their app, so leave this
# empty in production. It exists for `npm run dev` against a deployed API.
# CORS_ALLOWED_ORIGINS=http://localhost:5173


# ===========================================================================
# 1. Database — Messaging's OWN schema, and nothing else
# ===========================================================================
#
# This connection reaches Messaging's tables only. It is not a route into
# another product's data: there is no foreign data wrapper here, no linked
# server, no cross-database view, and no credential for another product's
# database. Everything owned elsewhere is read live over HTTP (section 3).
#
# A cross-database join is not a shortcut in this product; it is the
# architecture failing. See docs/DATA_OWNERSHIP.md.

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=aicountly_messaging
DB_USER=aicountly_messaging
DB_PASS=replace-with-the-database-password
# Optional. Defaults to public.
# DB_SCHEMA=public


# ===========================================================================
# 2. Public URLs and the webhook base
# ===========================================================================

# This product's public origin, used to build attachment download links.
MESSAGING_PUBLIC_BASE_URL=https://messaging.aicountly.com

# The origin providers were given when their webhooks were registered.
#
# THIS IS A SECURITY CONTROL, not cosmetic. Some providers (Twilio among them)
# sign the request URL, and that URL is reconstructed from THIS value rather
# than from the incoming Host header — otherwise anybody who can set Host could
# make a forged signature verify. Set it to the exact origin you registered.
MESSAGING_WEBHOOK_BASE_URL=https://messaging.aicountly.com


# ===========================================================================
# 3. Sibling Aicountly products — read LIVE, never mirrored
# ===========================================================================
#
# Each base URL defaults to the right host for APP_ENV, so in a normal
# deployment you set only the service keys. A key being absent is not an error:
# the integration reports itself as "not connected", the screens that depend on
# it say so, and nothing else breaks. That is the designed behaviour — see
# Features.php and docs/INTEGRATIONS.md.
#
# An empty value here means the feature is OFF. It never means "use a local
# copy", because there is no local copy.

# --- Manage: the tenant boundary. No feature flag; it is not optional. ------
# MANAGE_API_BASE=https://manage.aicountly.com
MANAGE_SERVICE_KEY=

# --- Contacts: customer identity -------------------------------------------
# CONTACTS_API_BASE=https://contacts.aicountly.com
CONTACTS_SERVICE_KEY=

# --- Books: invoices, balances, receipts -----------------------------------
# BOOKS_API_BASE=https://books.aicountly.com
BOOKS_SERVICE_KEY=

# --- Sales: orders and fulfilment ------------------------------------------
# SALES_API_BASE=https://sales.aicountly.com
SALES_SERVICE_KEY=

# --- Pay: payment links and payment state ----------------------------------
# Messaging asks Pay for a link and keeps the URL it is handed. It does not
# implement a gateway and does not keep a payment ledger.
# PAY_API_BASE=https://pay.aicountly.com
PAY_SERVICE_KEY=

# --- Appointments: bookings ------------------------------------------------
# APPOINTMENTS_API_BASE=https://appointments.aicountly.com
APPOINTMENTS_SERVICE_KEY=

# --- Calendar: events (read only; Calendar owns the event) -----------------
CALENDAR_SERVICE_KEY=

# --- Drive / Vault: documents and their scan state -------------------------
# DRIVE_API_BASE=https://drive.aicountly.com
DRIVE_SERVICE_KEY=

# --- Reach: campaign context, so Messaging does not rebuild campaigns ------
# REACH_API_BASE=https://reach.aicountly.com
REACH_SERVICE_KEY=

# --- Billing: subscription and plan context --------------------------------
BILLING_SERVICE_KEY=


# ===========================================================================
# 4. Inbound service contract — other products sending through Messaging
# ===========================================================================
#
# Comma-separated app:key pairs. A product presenting one of these keys on
# POST /api/v1/messages is authenticated AS THAT PRODUCT, and the `origin`
# recorded on the message comes from the key rather than from the request body.
#
# Generate each key with something like `openssl rand -hex 32`, give it to the
# calling product, and never reuse one between environments.
#
# SERVICE_KEYS=appointments:REPLACE_ME,billing:REPLACE_ME,books:REPLACE_ME
SERVICE_KEYS=


# ===========================================================================
# 5. Channel providers — the credential lives HERE, never in the database
# ===========================================================================
#
# A channel connection row stores the NAME of the variable holding its
# credential (`credential_ref`), never the credential. The adapter resolves it
# from this environment at the moment of the call, and the API returns a
# `credential_present` boolean so a screen can show the state without ever
# seeing the value.
#
# Name each variable after the connection it serves. The two below are the
# convention the UI suggests; add one per connection.

# WhatsApp Cloud API — the permanent access token for the phone number.
MESSAGING_WHATSAPP_TOKEN=
# The app secret used to verify X-Hub-Signature-256 on every webhook.
MESSAGING_WHATSAPP_WEBHOOK_SECRET=
# Graph API version. Optional — the adapter has a default and follows this when
# set, so a version bump does not need a code change.
# MESSAGING_WHATSAPP_GRAPH_VERSION=v21.0

# Twilio (SMS) — the auth token for the account, which is also what signs the
# inbound webhook.
MESSAGING_TWILIO_AUTH_TOKEN=

# RCS. The adapter REFUSES to send until both of these are set, because there
# is no single RCS contract to assume and a silent fall back to SMS would bill
# a customer for a channel they did not choose.
# MESSAGING_RCS_API_BASE=
# MESSAGING_RCS_PROVIDER_STYLE=


# ===========================================================================
# 6. Attachments
# ===========================================================================

# Where inbound and outbound media are stored. Keep it OUTSIDE the document
# root: a file served directly is a file served without a permission check.
MESSAGING_ATTACHMENT_DIR=/home/USER/messaging-attachments

# Signing key for time-limited attachment download links. Any long random
# string; `openssl rand -hex 32` is fine. Changing it invalidates outstanding
# links, which is the point.
MESSAGING_ATTACHMENT_SIGNING_KEY=

# Malware scanner, run on every attachment before it can be sent or opened.
# An UNSET scanner means files are marked "not scanned", and an unscanned
# attachment does not go to a customer — DispatchGuard refuses it. That is
# deliberate: a product that sends unscanned files because nobody configured a
# scanner is worse than one that says it cannot.
# MESSAGING_MALWARE_SCAN_COMMAND=/usr/bin/clamdscan --no-summary --fdpass


# ===========================================================================
# 7. AI — configured in Console, never here
# ===========================================================================
#
# Messaging holds NO model provider key. It asks Aicountly Console for the
# model configuration and a short-lived credential, which is what makes AI
# governable in one place for the whole fleet. With these unset, every AI
# feature reports itself unavailable and names this as the reason; nothing
# silently degrades into a guess.

# CONSOLE_API_URL=https://console.aicountly.com
CONSOLE_SERVICE_KEY=


# ===========================================================================
# 8. Feature flags
# ===========================================================================
#
# MESSAGING_<FLAG>_ENABLED, where FLAG is one of:
#
#   AI JOURNEYS OUTCOMES REALTIME
#   CONTACTS BOOKS SALES PAY APPOINTMENTS CALENDAR DRIVE REACH BILLING
#
# JOURNEYS, OUTCOMES and REALTIME are on unless you turn them off — they are
# features Messaging owns outright. NO INTEGRATION IS ON BY DEFAULT: an
# integration is on when somebody has configured it, never because the code
# for it shipped. Setting a flag to 1 without its service key still leaves the
# integration off, and /api/health says which key is missing.
#
# MESSAGING_BOOKS_ENABLED=1
# MESSAGING_REALTIME_ENABLED=0
