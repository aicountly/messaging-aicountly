# ---------------------------------------------------------------------------
# Messaging API — server environment template
#
# Unlike the React build, this file is read at RUNTIME on every request. It
# belongs on the server and only on the server:
#
#   1. Copy this file to <document root>/api/.env by hand, once (cPanel File
#      Manager or SSH).
#   2. It is git-ignored, and every rsync step passes --exclude='.env', so a
#      --delete deploy leaves it untouched.
#
# EVERY VALUE BELOW IS A PLACEHOLDER. Nothing in this file is a real
# credential, and nothing real may ever be committed to it. Fill it in on the
# server.
#
# See docs/DEPLOYMENT.md, docs/ARCHITECTURE.md and docs/SECURITY.md.
# ---------------------------------------------------------------------------

# Which deployment this is: production | sandbox | local
# Reported by GET /api/health, so you can tell the two environments apart.
APP_ENV=production

# Which deployment this is: production, sandbox or local. It decides which
# Manage (the tenant check), Contacts, Books, Sales, Pay, Appointments and AI
# Pulse this API — and its CLI workers — talk to, and it is read from HERE ONLY:
# never from a request's Host header, and never "sandbox because a cron job has
# no Host" (X-09). Unset, APP_ENV above is used; when neither is recognised no
# sibling is called and bin/journey-tick.php / bin/dispatch-worker.php refuse to
# run. Service keys are bound to it too (X-AIC-Environment).
AIC_ENVIRONMENT=production

# This product's own key, used as the X-Saas-Origin it sends to sibling
# products. Leave it as it is.
APP_PRODUCT_KEY=messaging

# AICOUNTLY portal auth API. Leave unset unless you are pointing at a
# non-standard portal — my.aicountly.com serves BOTH production and sandbox.
# (sandbox.aicountly.com is a login redirect only; it does not serve seskey or
# validatesession.)
# PORTAL_AUTH_BASE=https://my.aicountly.com

# Comma-separated origins allowed to call this API cross-origin.
# Both deployed environments are same-origin with their app, so leave this
# empty in production. It exists for `npm run dev` against a deployed API.
# CORS_ALLOWED_ORIGINS=http://localhost:5173


# ===========================================================================
# 1. Database — Messaging's OWN schema, and nothing else
# ===========================================================================
#
# This connection reaches Messaging's tables only. It is not a route into
# another product's data: there is no foreign data wrapper here, no linked
# server, no cross-database view, and no credential for another product's
# database. Everything owned elsewhere is read live over HTTP (section 3).
#
# A cross-database join is not a shortcut in this product; it is the
# architecture failing. See docs/DATA_OWNERSHIP.md.

# The database NAME and USERNAME come from Console (Console > SaaS Database Details), which
# records them once per product and environment. In Console, generate Messaging's key on this
# deployment's row (Generate key; Console shows it ONCE, and it starts with sdb_) and set:
# CONSOLE_API_URL is the Console API base INCLUDING /api (https://console.aicountly.org/api).
CONSOLE_API_URL=
# The variable is called CONSOLE_DB_DETAILS_KEY. A key put under any other name leaves Console
# unused (nothing is asked, nothing fails loudly) and the local DB_NAME / DB_USER in charge.
CONSOLE_DB_DETAILS_KEY=
# The API asks GET $CONSOLE_API_URL/database-details/resolve with that key as a bearer token
# (src/ConsoleDatabaseDetails.php) for every request, bin/ worker and bin/migrate.php. Answers
# are cached (5 minutes); if Console is briefly unreachable the last good answer (up to 7 days
# old) is used and logged. A revoked key or inactive row is never covered by the cache.
# Only the name and username come from Console (the same split Connect uses): it never holds a
# password, and any other field in its answer is ignored. Host, port and password stay here and
# are still required (the password must belong to the user Console names for this row).
DB_HOST=127.0.0.1
DB_PORT=5432
DB_PASS=replace-with-the-database-password
# Optional: disable | allow | prefer | require | verify-ca | verify-full. Unset, libpq's default
# ("prefer") applies, which is what Connect uses.
# DB_SSLMODE=require
# Optional. Defaults to public.
# DB_SCHEMA=public
# LOCAL FALLBACK ONLY - used when CONSOLE_API_URL / CONSOLE_DB_DETAILS_KEY are not both set
# (local development, the test suites). Do not set these on a deployed server: while the Console
# settings are present they are not read.
# DB_NAME=aicountly_messaging
# DB_USER=aicountly_messaging

# After setting these, apply the schema with `php <document root>/api/bin/migrate.php`.
# `php <document root>/api/bin/db-check.php` shows where each setting comes from and whether the
# database accepts it. Confirm with `curl https://<host>/api/health`
# (`database.source` is "console" when Console supplies the name and username).


# ===========================================================================
# 2. Public URLs and the webhook base
# ===========================================================================

# This product's public origin, used to build attachment download links.
MESSAGING_PUBLIC_BASE_URL=https://messaging.aicountly.com

# The origin providers were given when their webhooks were registered.
#
# THIS IS A SECURITY CONTROL, not cosmetic. Some providers (Twilio among them)
# sign the request URL, and that URL is reconstructed from THIS value rather
# than from the incoming Host header — otherwise anybody who can set Host could
# make a forged signature verify. Set it to the exact origin you registered.
MESSAGING_WEBHOOK_BASE_URL=https://messaging.aicountly.com


# ===========================================================================
# 3. Sibling Aicountly products — read LIVE, never mirrored
# ===========================================================================
#
# Each base URL defaults to the right host for APP_ENV, so in a normal
# deployment you set only the service keys. A key being absent is not an error:
# the integration reports itself as "not connected", the screens that depend on
# it say so, and nothing else breaks. That is the designed behaviour — see
# Features.php and docs/INTEGRATIONS.md.
#
# An empty value here means the feature is OFF. It never means "use a local
# copy", because there is no local copy.

# --- Manage: the tenant boundary. No feature flag; it is not optional. ------
# MANAGE_API_BASE=https://manage.aicountly.com
MANAGE_SERVICE_KEY=

# --- Contacts: customer identity -------------------------------------------
# Read only with the signed-in person's own session, from the COMPANY
# directory (contract v1). No key: switch it on with MESSAGING_CONTACTS_ENABLED=1.
# CONTACTS_API_BASE=https://contacts.aicountly.com

# --- Books: invoices, balances, receipts -----------------------------------
# Read only as the signed-in person (Books has no product-key access), for the
# ledger a contact is linked to in Contacts. Switch on with MESSAGING_BOOKS_ENABLED=1.
# BOOKS_API_BASE=https://books.aicountly.com

# --- Sales: orders and fulfilment ------------------------------------------
# SALES_API_BASE=https://sales.aicountly.com
SALES_SERVICE_KEY=

# --- Pay: payment requests and payment state -------------------------------
# Messaging reads a payment request from Pay (GET v1/payment-requests/{id}) and
# shows what Pay says. It does not implement a gateway and does not keep a
# payment ledger. Every call carries this key, AIC_ENVIRONMENT, the signed-in
# person's id and their own session; the company must also allow Messaging in
# Pay (Settings -> Connected apps) and Pay's SERVICE_KEYS must list `messaging`.
# PAY_API_BASE=https://pay.aicountly.com
PAY_SERVICE_KEY=

# --- Appointments: bookings ------------------------------------------------
# APPOINTMENTS_API_BASE=https://appointments.aicountly.com
APPOINTMENTS_SERVICE_KEY=

# (There is no Calendar integration: Messaging does not read Calendar. Event facts
# arrive in the send request; reminders on Calendar events are the owner's own and
# are not delivered here.)

# --- Drive / Vault: documents and their scan state -------------------------
# DRIVE_API_BASE=https://drive.aicountly.com
DRIVE_SERVICE_KEY=

# --- Reach: campaign context, so Messaging does not rebuild campaigns ------
# REACH_API_BASE=https://reach.aicountly.com
REACH_SERVICE_KEY=

# --- Billing: subscription and plan context --------------------------------
BILLING_SERVICE_KEY=


# ===========================================================================
# 4. Inbound service contract — other products sending through Messaging
# ===========================================================================
#
# Comma-separated app:key pairs. A product presenting one of these keys on
# POST /api/v1/messages is authenticated AS THAT PRODUCT, and the `origin`
# recorded on the message comes from the key rather than from the request body.
#
# Generate each key with something like `openssl rand -hex 32`, give it to the
# calling product, and never reuse one between environments.
#
# SERVICE_KEYS=appointments:REPLACE_ME,billing:REPLACE_ME,books:REPLACE_ME
SERVICE_KEYS=
#
# A key reaches only its ServicePolicy routes, must send X-AIC-Environment equal
# to AIC_ENVIRONMENT, and acts with nobody signed in only for a company that
# allowed it in Settings — or one listed here (ops override; explicit ids only):
# SERVICE_KEY_COMPANIES=appointments:101|102,helpdesk:101
SERVICE_KEY_COMPANIES=

# The wire contract for Appointments' client notices (company context, E.164
# recipient, templates, consent basis, idempotency, not_after, delivery states)
# is docs/APPOINTMENTS_MESSAGING_CONTRACT.md. Appointments must ALSO hold this
# key as MESSAGING_SERVICE_KEY and set MESSAGING_API_BASE explicitly.
#
# Which products may RECORD a consent they captured by sending it with a
# message (default: appointments). A product not listed here cannot create
# consent by putting an object in a request body.
# CONSENT_SERVICE_APPS=appointments
#
# A public booking form's checkbox proves SOMEONE ticked it, not that the phone
# number typed beside it is theirs. By default such a consent is recorded as
# `pending` and nothing is sent until the contact is verified some other way (or
# an agent grants it in Channels & Trust). Set to 1 ONLY after the business has
# decided that an unverified checkbox is enough for appointment notices.
# CONSENT_ACCEPT_UNVERIFIED=0
#
# Caps on service sends, per calling product. A loop in a caller, or a public
# form submitted with somebody else's number, must not message one person
# repeatedly or flood a company's sender.
# SERVICE_ADDRESS_DAILY_CAP=20
# SERVICE_COMPANY_PER_MINUTE=120


# ===========================================================================
# 5. Channel providers — the credential lives HERE, never in the database
# ===========================================================================
#
# A channel connection row stores the NAME of the variable holding its
# credential (`credential_ref`), never the credential. The adapter resolves it
# from this environment at the moment of the call, and the API returns a
# `credential_present` boolean so a screen can show the state without ever
# seeing the value.
#
# Name each variable after the connection it serves. The two below are the
# convention the UI suggests; add one per connection.

# WhatsApp Cloud API — the permanent access token for the phone number.
MESSAGING_WHATSAPP_TOKEN=
# The app secret used to verify X-Hub-Signature-256 on every webhook.
MESSAGING_WHATSAPP_WEBHOOK_SECRET=
# Graph API version. Optional — the adapter has a default and follows this when
# set, so a version bump does not need a code change.
# MESSAGING_WHATSAPP_GRAPH_VERSION=v21.0

# Twilio (SMS) — the auth token for the account, which is also what signs the
# inbound webhook.
MESSAGING_TWILIO_AUTH_TOKEN=

# RCS. The adapter REFUSES to send until both of these are set, because there
# is no single RCS contract to assume and a silent fall back to SMS would bill
# a customer for a channel they did not choose.
# MESSAGING_RCS_API_BASE=
# MESSAGING_RCS_PROVIDER_STYLE=

# Only for a connection whose credential reference is console:<name> — a
# channel secret kept in Aicountly Console instead of in this file. Messaging
# asks Console for module channel:<name> at the moment of use and never writes
# the answer to disk. Leave both unset when every reference is a variable name.
# (Once Console marks Messaging "Using AI Pulse", mark those channel:<name>
# modules keeps_own_credential there, or Console stops answering for them.)
# CONSOLE_API_URL=https://console.aicountly.com
# CONSOLE_SERVICE_KEY=


# ===========================================================================
# 6. Attachments
# ===========================================================================

# Where inbound and outbound media are stored. Keep it OUTSIDE the document
# root: a file served directly is a file served without a permission check.
MESSAGING_ATTACHMENT_DIR=/home/USER/messaging-attachments

# Signing key for time-limited attachment download links. Any long random
# string; `openssl rand -hex 32` is fine. Changing it invalidates outstanding
# links, which is the point.
MESSAGING_ATTACHMENT_SIGNING_KEY=

# Malware scanner, run on every attachment before it can be sent or opened.
# An UNSET scanner means files are marked "not scanned", and an unscanned
# attachment does not go to a customer — DispatchGuard refuses it. That is
# deliberate: a product that sends unscanned files because nobody configured a
# scanner is worse than one that says it cannot.
# MESSAGING_MALWARE_SCAN_COMMAND=/usr/bin/clamdscan --no-summary --fdpass


# ===========================================================================
# 7. AI — runs through AI Pulse; there is no model key here
# ===========================================================================
#
# Every AI feature — reply drafts, translation, rewrites, summaries, intent
# classification, journey proposals and the Command Centre narration — calls
# the AI Pulse gateway, as the signed-in user. Pulse picks the model (the one
# Console binds to Pulse), enforces the daily allowances and reports usage per
# feature. Messaging holds no model key, chooses no model and has no fallback
# model: when Pulse cannot answer, the assistant says it is unavailable.
#
# Which Pulse. Unset, it follows this API's host: the sandbox host
# (messaging.gh.aicountly.com) and localhost use https://pulse.gh.aicountly.com,
# anything else https://pulse.aicountly.com. Set it only to point elsewhere.
# PULSE_API_ORIGIN=https://pulse.aicountly.com
#
# This product's own AI Pulse gateway key, minted on Pulse with
#   php spark pulse:gateway-key mint messaging
# (production and sandbox Pulse are separate, so each has its own key). Sent
# on every AI call as X-Pulse-Service-Key — with the signed-in user's session
# and X-Pulse-Product: messaging, or alone for AI a sibling product asks for
# with its service key (nobody signed in here). Put it here straight from the
# terminal that printed it; it is a server-side secret and never belongs in a
# VITE_* variable or anywhere in the web build.
#
# REQUIRED BY 2026-11-15: until then Pulse also accepts the user's session
# alone; after that it answers 401 product_key_required and every AI feature
# stops. Unset, only the session is sent, exactly as before. CONSOLE_SERVICE_KEY
# is NOT a fallback for it (Pulse retires the estate key for AI). A value with
# a line break or another control character is refused and nothing is sent.
# PULSE_SERVICE_KEY=
#
# AI is on by default; MESSAGING_AI_ENABLED=0 switches it off for this
# deployment (section 8). What AI may do per company is set in Channels & Trust.


# ===========================================================================
# 8. Feature flags
# ===========================================================================
#
# MESSAGING_<FLAG>_ENABLED, where FLAG is one of:
#
#   AI JOURNEYS OUTCOMES REALTIME
#   CONTACTS BOOKS SALES PAY APPOINTMENTS DRIVE REACH BILLING
#
# AI, JOURNEYS, OUTCOMES and REALTIME are on unless you turn them off — they
# are features Messaging owns outright (AI runs through AI Pulse; its only
# setting is PULSE_SERVICE_KEY, section 7). NO INTEGRATION IS ON BY DEFAULT: an
# integration is on when somebody has configured it, never because the code
# for it shipped. Setting a flag to 1 without its service key still leaves the
# integration off, and /api/health says which key is missing.
#
# MESSAGING_BOOKS_ENABLED=1
# MESSAGING_REALTIME_ENABLED=0
# MESSAGING_AI_ENABLED=0
