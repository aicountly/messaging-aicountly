# ---------------------------------------------------------------------------
# Messaging API — Apache config for <document root>/api on cPanel.
#
# This file is deployed with the API. The web build ships its own .htaccess for
# the document root, and those rules stop applying once these take over.
# ---------------------------------------------------------------------------

<IfModule mod_rewrite.c>
  RewriteEngine On
  # No RewriteBase on purpose: Apache resolves the substitution against whatever
  # directory this file sits in, so the API works at <docroot>/api and at the
  # root of a dedicated vhost without editing this line. index.php strips its
  # own mount point to match.

  # Apache does not hand the Authorization header to PHP under CGI/FastCGI
  # unless it is copied explicitly. Without this the relay forwards no
  # credential, the portal answers 401, and sign-in fails for everyone with
  # nothing in the logs to explain it. (Hosts on Apache 2.4.13+ can use
  # `CGIPassAuth On` instead; this form works everywhere.)
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # Only the front controller may answer. Any other real file or folder here
  # (src/, bin/, tests/, database/, a stray error_log) would otherwise be served
  # as text or run as PHP with the live .env, so it is a 404. There is no public/
  # under the API, so the only exceptions are index.php and .well-known/, the
  # latter kept reachable for certificate renewal. The pattern is relative, with
  # no RewriteBase like the rules around it, so it holds at <docroot>/api and at
  # a dedicated vhost root alike; it sits ahead of the front-controller rule.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule !^(index\.php|\.well-known/.*)?$ - [R=404,L]

  # Everything that is not a real file goes to the front controller.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.php [L]
</IfModule>

# --- Hardening -------------------------------------------------------------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header always set Cache-Control "no-store"
  Header set Referrer-Policy "no-referrer"

  # This API serves conversation content and, through the context endpoints,
  # balances and order values read live from their owning products. None of it
  # may come to rest in a shared cache or a proxy, and a service worker must
  # not be able to keep it either. index.php sets no-store per response; this
  # is the belt to that braces.
  Header always set Pragma "no-cache"
</IfModule>

# --- Upload limits ---------------------------------------------------------
# Message attachments are capped at 16MB in Domain/AttachmentService. PHP has
# to allow at least that much or the cap would be enforced by a truncated
# upload rather than by a clear refusal.
<IfModule mod_php.c>
  php_value upload_max_filesize 16M
  php_value post_max_size 20M
</IfModule>

# The API's .env sits inside the document root, so without this it would be
# fetchable over HTTP at https://messaging.aicountly.com/api/.env.
RedirectMatch 404 /\.(?!well-known)

# PHP writes its log to a file literally named error_log in whatever directory a
# script runs in; on cPanel it is served as plain text and leaks stack traces
# and any secret an error printed. Refuse it at every depth. Like the dotfile
# rule above this is mod_alias, so it keeps applying even inside a subdirectory
# that ships its own .htaccess — where the mod_rewrite guard above would not.
RedirectMatch 404 /error_log$
